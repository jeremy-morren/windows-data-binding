<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Consumes the generator the way a project outside this repository would - as an analyzer project
    reference rather than as the package. Building this project is what keeps that wiring honest: if
    the analyzer ever stops flowing, OrderBinder loses every property it has and the compile fails.
  -->
  <Import Project="..\..\WinDataBinding.ProjectReference.props" />

</Project>
